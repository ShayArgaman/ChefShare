<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet access is required for every Firebase call (Auth, Firestore, Storage) and Glide. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ChefShareApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChefShare"
        tools:targetApi="31">

        <!-- Launcher: splash + auth router. Routes to Login (signed out) or Feed (signed in). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ChefShare.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login / Signup (single screen, two modes). -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Community feed. -->
        <activity
            android:name=".ui.feed.FeedActivity"
            android:exported="false" />

        <!-- Add Recipe. -->
        <activity
            android:name=".ui.addrecipe.AddRecipeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Recipe Detail. -->
        <activity
            android:name=".ui.detail.RecipeDetailActivity"
            android:exported="false" />

    </application>
</manifest>
