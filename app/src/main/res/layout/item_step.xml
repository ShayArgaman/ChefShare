<?xml version="1.0" encoding="utf-8"?>
<!-- One preparation step: numbered circle + step text. Inflated once per step. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/textStepNumber"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_circle_number"
        android:gravity="center"
        android:textColor="@color/emerald_dark"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textStepText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@color/on_surface_variant"
        android:textSize="15sp" />
</LinearLayout>
