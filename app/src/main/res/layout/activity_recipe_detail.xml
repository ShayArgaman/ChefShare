<?xml version="1.0" encoding="utf-8"?>
<!--
  Recipe Detail.
  A ScrollView wraps the whole page so long recipes scroll smoothly without overlap. The Back and
  Heart buttons live OUTSIDE the ScrollView (in the FrameLayout) so they float and stay reachable
  while the hero + content scroll beneath them.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Scrollable content (hidden until the recipe loads). -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero image -->
            <ImageView
                android:id="@+id/imageHero"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@color/surface_container"
                android:contentDescription="@string/cd_hero_image"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/textTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="Zesty Lime Salmon" />

                <!-- Author -->
                <TextView
                    android:id="@+id/textAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp"
                    tools:text="By Chef Maria" />

                <!-- Category tag (hidden if the recipe has no category) -->
                <TextView
                    android:id="@+id/textCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_category_tag"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/emerald_darkest"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Dinner" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/outline_variant" />

                <!-- Ingredients -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/section_ingredients"
                    android:textColor="@color/on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <!-- Preparation -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/section_preparation"
                    android:textColor="@color/on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Centered loader shown until the recipe arrives. -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/emerald" />

    <!-- Floating Back (top-left). -->
    <ImageView
        android:id="@+id/buttonBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_scrim"
        android:clickable="true"
        android:contentDescription="@string/cd_back"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back" />

    <!-- Floating favorite toggle (top-right), shown once loaded. -->
    <ImageView
        android:id="@+id/buttonLike"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_scrim"
        android:clickable="true"
        android:contentDescription="@string/cd_favorite"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_favorite_border"
        android:visibility="gone"
        tools:visibility="visible" />

</FrameLayout>
